#include <iostream>
using namespace std;
struct Node{
    int data;
    Node*next;
};
Node*head=NULL;
void insertBeginning(int val){
    Node*newNode= new Node{val,head};
    head=newNode;
}
void insertEnd(int val){
    Node*newNode=new Node{val,NULL};
    if(head==NULL){
        head=newNode;
        return;
    }
    Node*temp=head;
    while(temp->next!=NULL){
        temp=temp->next;
        temp->next=newNode;
    }  
}
void insertAfter(int key, int val){
    Node*temp=head;
    while(temp!=NULL && temp->data!=key)
    temp=temp->next;
    if(temp==NULL){
        cout<<"Node"<<key<<"not found\n";
        return;
    }
    Node*newNode= new Node{val,temp->next};
    temp->next=newNode;
}
void display(){
    if(head==NULL){
        cout<<"List is empty\n";
        return;
    }
    Node*temp=head;
    while(temp!=NULL){
        cout<<temp->data<<"->";
        temp=temp->next;
    }
    cout<<"Null\n";
}
int main(){
    int ch,val,key;
    while(1){
        cout<<"\n1.Insert Begin 2. Insert End 3. Insert After 4. Display 5. Exit\n";
        cin>>ch;
        switch(ch){
            case1: cout<<"Value: ";
            cin>>val;
            insertBeginning(val);
            break;

            case 1: cout<<"Value: ";
            cin>>val;
            insertBeginning(val);
            break;

            case 2: cout<<"Value: ";
            cin>>val;
            insertEnd(val);
            break;

            case 3: cout<<"Key,Value: ";
            cin>>key>>val;
            insertAfter(key,val);
            break;

            case 4: display();
            break;

            case 5: return 0;
            default : cout<<"Invalid choice\n";
        }
    }
   return 0;
}
