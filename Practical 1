#include<iostream>
using namespace std;
int main(){
    	int arr[100],n,i,choice,pos,value;
        	//Create Array
            	cout<<"Enter number of elements: ";
                	cin>>n;
                    	cout<<"Enter array elements: ";
                        	for(i=0;i<n;i++){
                                		cin>>arr[i];
                            }
                            	while(1){
                                    		cout<<"\n1.Inter\n2.Delete\n3.Traverse\n4.Search\n";
                                            		cin>>choice;
                                                    		switch(choice){
                                                                			case 1://Insertion
                                                                            				cout<<"Enter position (0 to"<<n<<"):";
                                                                                            				cin>>pos;
                                                                                                            				cout<<"Enter value: ";
                                                                                                                            				cin>>value;
                                                                                                                                            		for(i=n;i>pos;i--){
                                                                                                                                                        			arr[i]=arr[i-1];
                                                                                                                                                    }
                                                                                                                                                    		arr[pos]=value;
                                                                                                                                                            		n++;
                                                                                                                                                                    		cout<<"Array after insertion: ";
                                                                                                                                                                            		for(i=0;i<n;i++){
                                                                                                                                                                                        			cout<<arr[i]<<" ";
                                                                                                                                                                                    }
                                                                                                                                                                                    		break;
                                                                                                                                                                                            		
                                                                                                                                                                                                    		case 2://Deletion
                                                                                                                                                                                                            		cout<<"Enter position to delete ";
                                                                                                                                                                                                                    		cin>>pos;
                                                                                                                                                                                                                            		for(i=pos;i<n-1;i++){
                                                                                                                                                                                                                                        			arr[i]=arr[i+1];
                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                    		n--;
                                                                                                                                                                                                                                            		cout<<"Array after deletion: ";
                                                                                                                                                                                                                                                    		for(i=0;i<n;i++){
                                                                                                                                                                                                                                                                			cout<<arr[i]<<" ";
                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                            		break;
                                                                                                                                                                                                                                                                    		
                                                                                                                                                                                                                                                                            		case 3: //Traversal
                                                                                                                                                                                                                                                                                    		cout<<"Array elements are: ";
                                                                                                                                                                                                                                                                                            		for(i=0;i<n;i++){
                                                                                                                                                                                                                                                                                                        			cout<<arr[i]<<" ";
                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                    		break;
                                                                                                                                                                                                                                                                                                            		
                                                                                                                                                                                                                                                                                                                    		case 4: //Search
                                                                                                                                                                                                                                                                                                                            		cout<<"Enter value to search: ";
                                                                                                                                                                                                                                                                                                                                    		cin>>value;
                                                                                                                                                                                                                                                                                                                                            		for(i=0;i<n;i++){
                                                                                                                                                                                                                                                                                                                                                        			if(arr[i]==value){
                                                                                                                                                                                                                                                                                                                                                                        				cout<<"Element found at index "<<i;
                                                                                                                                                                                                                                                                                                                                                                                        				return 0;
                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                    			cout<<"Enter not found ";
                                                                                                                                                                                                                                                                                                                                                                			break;
                                                                                                                                                                                                                                                                                                                                                                            			
                                                                                                                                                                                                                                                                                                                                                                                        			default:
                                                                                                                                                                                                                                                                                                                                                                                                    			cout<<"Invalid choice! ";
                                                            }
                                }
                                		return 0;
}
                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                    }
                                                                                                                                                                                    }
                                                                                                                                                    }
                                                            }
                                }
                            }
}